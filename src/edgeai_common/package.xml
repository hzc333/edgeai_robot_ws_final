<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edgeai_common</name>
  <version>0.0.0</version>
  <description>Shared helpers for EdgeAI competition nodes: run-mode parameter resolution, QoS profiles from the runtime contract and robot_N/ frame names.</description>
  <maintainer email="huangzc333@gmail.com">hzc333</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
