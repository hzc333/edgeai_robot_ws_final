<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edgeai_system_tests</name>
  <version>0.0.0</version>
  <description>System tests, mocks and replay tools for the EdgeAI competition system. Mocks use the real shared interfaces and must never be part of a competition launch.</description>
  <maintainer email="huangzc333@gmail.com">hzc333</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>edgeai_robot_interfaces</depend>
  <depend>edgeai_common</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
